<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Day {{ day }}: {{ title }} | Modern AI Learning Studio</title>

  <!-- Tailwind CSS CDN with Typography Plugin -->
  <script src="https://cdn.tailwindcss.com?plugins=typography"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            studio: {
              navy: '#101828',      // Midnight Navy background
              card: '#1a2640',      // Elevated card container
              border: '#263658',    // Slate boundary line
              blue: '#1d4ed8',      // Deep Blue brand
              cyan: '#22d3ee',      // Electric Cyan accent
              violet: '#8b5cf6',    // Violet accent
              offwhite: '#f8fafc',  // Off-white light surface
              slate: '#64748b',     // Slate gray muted
              green: '#16a34a',     // Success green
              amber: '#f59e0b',     // Warning amber
              red: '#ef4444'        // Danger red
            }
          },
          fontFamily: {
            sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
            mono: ['JetBrains Mono', 'Consolas', 'Menlo', 'monospace']
          }
        }
      }
    }
  </script>

  <!-- KaTeX Mathematical Equations -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.css">
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/katex.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.8/dist/contrib/auto-render.min.js"
          onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}]});"></script>

  <style>
    pre code { font-family: 'JetBrains Mono', Consolas, Menlo, monospace; }
    .quiz-option { transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
    .quiz-option:hover:not(:disabled) { transform: translateX(4px); }
  </style>
</head>
<body class="bg-studio-navy text-slate-100 min-h-screen font-sans antialiased selection:bg-studio-cyan selection:text-studio-navy">

  <!-- ===================================================================== -->
  <!-- AREA 1: INTERACTIVE STUDY TOOLBAR (Sticky Top Header) -->
  <!-- ===================================================================== -->
  <header class="sticky top-0 z-50 bg-studio-navy/90 backdrop-blur-md border-b border-studio-border px-4 py-3 sm:px-8">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
      
      <!-- Brand & Milestone Badge -->
      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center gap-1.5 bg-studio-cyan/15 text-studio-cyan border border-studio-cyan/30 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-studio-cyan animate-ping"></span>
          Day {{ day }} of 30
        </span>
        <span class="text-xs font-semibold text-slate-400 border-l border-studio-border pl-3 hidden md:inline">
          {{ module }} Track
        </span>
      </div>

      <!-- Center: Title preview on scroll -->
      <div class="hidden lg:block text-xs font-medium text-slate-300 truncate max-w-md">
        {{ title }}
      </div>

      <!-- Right: Sandbox Status Badge & Action Launchers -->
      <div class="flex items-center space-x-2 text-xs">
        {% if validation.is_valid %}
        <span class="inline-flex items-center gap-1.5 bg-studio-green/15 text-emerald-400 border border-studio-green/30 px-3 py-1 rounded-full font-semibold">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
          {{ validation.status_badge }} ({{ validation.execution_time }}s)
        </span>
        {% else %}
        <span class="inline-flex items-center gap-1.5 bg-studio-red/15 text-rose-400 border border-studio-red/30 px-3 py-1 rounded-full font-semibold">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
          {{ validation.status_badge }}
        </span>
        {% endif %}

        {% if drive_links and drive_links.pptx_view_url %}
        <a href="{{ drive_links.pptx_view_url }}" target="_blank" class="bg-studio-blue hover:bg-blue-600 text-white font-medium px-3 py-1 rounded-lg transition inline-flex items-center gap-1 shadow-sm">
          <span>Slides (.pptx)</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
        {% endif %}

        <a href="#quiz" class="bg-studio-cyan hover:bg-cyan-400 text-studio-navy font-bold px-3 py-1 rounded-lg transition inline-flex items-center gap-1 shadow-sm">
          <span>Quiz</span>
        </a>
      </div>
    </div>
  </header>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex gap-8">

    <!-- ===================================================================== -->
    <!-- AREA 2: STICKY NAVIGATION SIDEBAR (Desktop Left Outline) -->
    <!-- ===================================================================== -->
    <aside class="hidden lg:block w-72 flex-shrink-0">
      <div class="sticky top-20 space-y-6">
        
        <!-- Outline Navigation Card -->
        <div class="bg-studio-card border border-studio-border rounded-xl p-5 shadow-lg">
          <h3 class="text-xs font-bold uppercase tracking-wider text-studio-cyan mb-3 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
            Curriculum Outline
          </h3>
          <nav class="space-y-1 text-xs">
            <a href="#overview" class="block py-1.5 px-2.5 rounded text-slate-300 hover:text-white hover:bg-studio-border transition font-medium">1. Objectives &amp; Overview</a>
            <a href="#intuition" class="block py-1.5 px-2.5 rounded text-slate-300 hover:text-white hover:bg-studio-border transition font-medium">2. Intuitive Mental Model</a>
            <a href="#math" class="block py-1.5 px-2.5 rounded text-slate-300 hover:text-white hover:bg-studio-border transition font-medium">3. Mathematical Derivations</a>
            <a href="#numerical" class="block py-1.5 px-2.5 rounded text-slate-300 hover:text-white hover:bg-studio-border transition font-medium">4. Numerical Walkthrough</a>
            <a href="#mechanics" class="block py-1.5 px-2.5 rounded text-slate-300 hover:text-white hover:bg-studio-border transition font-medium">5. Algorithmic Pipeline</a>
            <a href="#code" class="block py-1.5 px-2.5 rounded text-studio-cyan bg-studio-cyan/10 border border-studio-cyan/30 font-semibold">6. Python Code Lab</a>
            <a href="#walkthrough" class="block py-1.5 px-2.5 rounded text-slate-300 hover:text-white hover:bg-studio-border transition font-medium">7. Code Architecture</a>
            <a href="#casestudy" class="block py-1.5 px-2.5 rounded text-slate-300 hover:text-white hover:bg-studio-border transition font-medium">8. Industry Case Study</a>
            <a href="#pitfalls" class="block py-1.5 px-2.5 rounded text-slate-300 hover:text-white hover:bg-studio-border transition font-medium">9. Production Pitfalls</a>
            <a href="#interview" class="block py-1.5 px-2.5 rounded text-slate-300 hover:text-white hover:bg-studio-border transition font-medium">10. Interview Defense</a>
            <a href="#quiz" class="block py-1.5 px-2.5 rounded text-emerald-400 bg-emerald-500/10 border border-emerald-500/30 font-bold mt-2">11. Mastery Quiz</a>
          </nav>
        </div>

        <!-- Study Session Telemetry Box -->
        <div class="bg-studio-card border border-studio-border rounded-xl p-5 shadow-lg space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-studio-blue">Study Block Telemetry</div>
          <div class="text-xs text-slate-300 space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Scheduled Time:</span>
              <span class="font-semibold text-white">7:00 PM – 9:00 PM IST</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Calendar Alert:</span>
              <span class="text-emerald-400 font-medium">15m Popup Active</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Target Mastery:</span>
              <span class="text-studio-cyan font-bold">80%+ Passing</span>
            </div>
          </div>
        </div>

      </div>
    </aside>

    <!-- ===================================================================== -->
    <!-- AREA 3: CENTRAL LESSON FEED (Main Masterclass Stream) -->
    <!-- ===================================================================== -->
    <main class="flex-1 min-w-0 max-w-4xl space-y-10">

      <!-- Hero Header Banner -->
      <div id="overview" class="bg-gradient-to-br from-studio-card to-studio-navy border border-studio-border rounded-2xl p-6 sm:p-10 shadow-2xl">
        <div class="inline-flex items-center gap-2 text-xs font-bold text-studio-cyan uppercase tracking-widest mb-3">
          <span>Modern AI Learning Studio</span>
          <span>&bull;</span>
          <span>Curriculum Track: {{ module }}</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
          {{ title }}
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-3xl">
          Production masterclass containing closed-form mathematical derivations, AST-validated Scikit-Learn code, real-world case studies, data leakage warnings, and Staff-level technical interview defenses.
        </p>

        <!-- Objectives Checklist -->
        {% if objectives %}
        <div class="mt-8 pt-6 border-t border-studio-border">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Daily Competencies &amp; Outcomes:</h4>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            {% for obj in objectives %}
            <div class="text-xs bg-studio-navy/60 border border-studio-border rounded-lg p-3 text-slate-200 flex items-start gap-2">
              <span class="text-studio-cyan font-bold mt-0.5">&#10003;</span>
              <span>{{ obj }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
        {% endif %}
      </div>

      <!-- Real-Time Code Sandbox Telemetry Card -->
      <section id="code" class="bg-studio-card border border-studio-border rounded-2xl p-6 shadow-xl">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4 border-b border-studio-border pb-3">
          <div class="flex items-center gap-3">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
            </span>
            <h3 class="text-sm font-bold text-white tracking-wider uppercase">Isolated Subprocess AST Sandbox Telemetry</h3>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-xs bg-studio-navy text-emerald-400 px-3 py-1 rounded-full border border-studio-green/30 font-mono font-semibold">
              Exit Code: 0 (PASSED)
            </span>
            <span class="text-xs bg-studio-navy text-slate-300 px-3 py-1 rounded-full border border-studio-border font-mono">
              Time: {{ validation.execution_time }}s
            </span>
          </div>
        </div>
        <p class="text-xs text-slate-400 mb-4 leading-relaxed">
          The Python implementation in this lesson was extracted, validated against security AST policies, and executed in an isolated subprocess before publishing.
        </p>
        <div class="bg-studio-navy rounded-xl p-4 border border-studio-border text-xs font-mono text-emerald-400 overflow-x-auto max-h-56 leading-relaxed">
          <pre>{{ validation.stdout }}</pre>
        </div>
      </section>

      <!-- Markdown Masterclass Body -->
      <article class="prose prose-invert max-w-none prose-headings:text-slate-100 prose-headings:font-bold prose-h2:text-2xl prose-h2:border-b prose-h2:border-studio-border prose-h2:pb-3 prose-h2:mt-12 prose-h3:text-lg prose-h3:text-studio-cyan prose-p:text-slate-300 prose-p:leading-relaxed prose-a:text-studio-cyan prose-code:text-studio-cyan prose-pre:bg-studio-navy prose-pre:border prose-pre:border-studio-border prose-pre:rounded-xl">
        {{ content_html | safe }}
      </article>

      <!-- ===================================================================== -->
      <!-- INTERACTIVE JAVASCRIPT MASTERY QUIZ -->
      <!-- ===================================================================== -->
      <section id="quiz" class="bg-gradient-to-b from-studio-card to-studio-navy border border-studio-cyan/30 rounded-2xl p-6 sm:p-10 shadow-2xl">
        <div class="flex flex-wrap items-center justify-between gap-4 mb-8 border-b border-studio-border pb-5">
          <div>
            <span class="text-xs font-bold uppercase text-studio-cyan tracking-wider">Concept Verification Checkpoint</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Interactive Mastery Quiz</h2>
            <p class="text-xs text-slate-400 mt-1">Target passing score: 80% or higher. Immediate theoretical feedback provided upon selection.</p>
          </div>
          <div class="flex items-center gap-3">
            <div id="quiz-score-badge" class="bg-studio-navy px-4 py-2 rounded-xl text-xs font-semibold text-slate-200 border border-studio-border shadow-inner">
              Mastery Score: <span id="current-score" class="text-studio-cyan font-bold text-sm">0</span> / <span id="total-questions">{{ quiz | length }}</span>
            </div>
          </div>
        </div>

        <!-- Mastery Progress Bar -->
        <div class="w-full bg-studio-navy rounded-full h-2 mb-8 border border-studio-border overflow-hidden">
          <div id="mastery-meter" class="bg-studio-cyan h-2 transition-all duration-300 ease-out" style="width: 0%"></div>
        </div>

        <div class="space-y-8">
          {% for q in quiz %}
          <div class="quiz-card bg-studio-navy/60 border border-studio-border rounded-xl p-5 sm:p-6" data-question-id="{{ q.id }}" data-correct="{{ q.correct_index }}">
            <div class="flex items-start gap-3 mb-4">
              <span class="w-7 h-7 rounded-full bg-studio-cyan/20 text-studio-cyan border border-studio-cyan/40 text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">
                {{ loop.index }}
              </span>
              <p class="text-sm sm:text-base font-semibold text-white leading-snug">{{ q.question }}</p>
            </div>

            <div class="grid grid-cols-1 gap-2.5 ml-10">
              {% for opt in q.options %}
              <button type="button"
                      onclick="handleQuizAnswer(this, {{ loop.index0 }})"
                      class="quiz-option text-left text-xs sm:text-sm bg-studio-card hover:bg-studio-border border border-studio-border rounded-lg p-3.5 text-slate-200 transition-all flex items-center justify-between">
                <span>{{ opt }}</span>
                <span class="option-icon hidden font-bold text-base ml-2"></span>
              </button>
              {% endfor %}
            </div>

            <!-- Explanation Box (revealed on selection) -->
            <div class="quiz-explanation hidden ml-10 mt-4 bg-studio-navy border border-studio-border rounded-xl p-4 text-xs text-slate-300 leading-relaxed shadow-inner">
              <div class="font-bold text-studio-cyan mb-1.5 flex items-center gap-1.5">
                <svg class="w-4 h-4 text-studio-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                Theoretical Rationale
              </div>
              <p>{{ q.explanation }}</p>
            </div>
          </div>
          {% endfor %}
        </div>

        <!-- Mastery Completion Banner -->
        <div id="quiz-completion-banner" class="hidden mt-8 rounded-xl p-6 text-center border">
          <h4 id="banner-title" class="font-bold text-lg mb-1"></h4>
          <p id="banner-desc" class="text-xs leading-relaxed max-w-xl mx-auto"></p>
        </div>
      </section>

      <!-- Footer -->
      <footer class="border-t border-studio-border pt-8 pb-16 text-center text-xs text-slate-400 space-y-3">
        <div class="flex flex-wrap items-center justify-center gap-3 text-slate-300 font-medium">
          <span>Modern AI Learning Studio</span>
          <span>&bull;</span>
          <span>Zero-Cost Serverless Pipeline</span>
          <span>&bull;</span>
          <span>Google Workspace &amp; Slack Integrated</span>
        </div>
        <p class="text-slate-400">
          Curriculum synthesized autonomously with mathematical derivations, AST sandbox execution, and KaTeX rendering.
        </p>
      </footer>

    </main>
  </div>

  <!-- Interactive JavaScript Quiz & Copy Handlers -->
  <script>
    let score = 0;
    const answered = new Set();
    const totalQuestions = {{ quiz | length }};

    function handleQuizAnswer(buttonEl, selectedIdx) {
      const card = buttonEl.closest('.quiz-card');
      const questionId = card.getAttribute('data-question-id');

      if (answered.has(questionId)) {
        return;
      }
      answered.add(questionId);

      const correctIdx = parseInt(card.getAttribute('data-correct'), 10);
      const allButtons = card.querySelectorAll('.quiz-option');

      allButtons.forEach((btn, idx) => {
        btn.disabled = true;
        btn.classList.remove('hover:bg-studio-border', 'cursor-pointer');
        const icon = btn.querySelector('.option-icon');

        if (idx === correctIdx) {
          btn.classList.add('bg-emerald-950/70', 'border-emerald-500', 'text-emerald-300');
          if (icon) {
            icon.classList.remove('hidden');
            icon.textContent = '✓';
            icon.classList.add('text-emerald-400');
          }
        } else if (idx === selectedIdx && selectedIdx !== correctIdx) {
          btn.classList.add('bg-rose-950/70', 'border-rose-500', 'text-rose-300');
          if (icon) {
            icon.classList.remove('hidden');
            icon.textContent = '✗';
            icon.classList.add('text-rose-400');
          }
        }
      });

      if (selectedIdx === correctIdx) {
        score++;
        document.getElementById('current-score').textContent = score;
      }

      // Update progress meter
      const pct = (answered.size / totalQuestions) * 100;
      document.getElementById('mastery-meter').style.width = pct + '%';

      // Reveal theoretical explanation
      const exp = card.querySelector('.quiz-explanation');
      if (exp) {
        exp.classList.remove('hidden');
      }

      // Evaluate completion when all questions answered
      if (answered.size === totalQuestions) {
        const finalPct = Math.round((score / totalQuestions) * 100);
        const banner = document.getElementById('quiz-completion-banner');
        const title = document.getElementById('banner-title');
        const desc = document.getElementById('banner-desc');

        banner.classList.remove('hidden');
        if (finalPct >= 80) {
          banner.classList.add('bg-emerald-950/40', 'border-emerald-500/50', 'text-emerald-300');
          title.textContent = `🎯 Mastery Confirmed! (${finalPct}%)`;
          desc.textContent = `Outstanding work! You have surpassed the 80% passing threshold for Day {{ day }}. Tomorrow's cloud trigger will unlock the next milestone.`;
        } else {
          banner.classList.add('bg-amber-950/40', 'border-amber-500/50', 'text-amber-300');
          title.textContent = `⚠️ Review Recommended (${finalPct}%)`;
          desc.textContent = `You completed the quiz with ${score}/${totalQuestions} correct. Re-read the mathematical derivations and code architecture sections before the scheduled 7:00 PM IST study session.`;
        }
      }
    }

    // Code Copy Buttons Setup
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('pre').forEach(pre => {
        const wrapper = document.createElement('div');
        wrapper.className = 'relative group';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const copyBtn = document.createElement('button');
        copyBtn.className = 'absolute top-3 right-3 bg-studio-card hover:bg-studio-border border border-studio-border text-slate-300 hover:text-white px-2.5 py-1 rounded text-xs opacity-0 group-hover:opacity-100 transition-opacity font-medium shadow';
        copyBtn.textContent = 'Copy Code';
        copyBtn.addEventListener('click', () => {
          const code = pre.querySelector('code') ? pre.querySelector('code').innerText : pre.innerText;
          navigator.clipboard.writeText(code).then(() => {
            copyBtn.textContent = 'Copied!';
            copyBtn.classList.add('text-studio-cyan', 'border-studio-cyan');
            setTimeout(() => {
              copyBtn.textContent = 'Copy Code';
              copyBtn.classList.remove('text-studio-cyan', 'border-studio-cyan');
            }, 2000);
          });
        });
        wrapper.appendChild(copyBtn);
      });
    });
  </script>
</body>
</html>
