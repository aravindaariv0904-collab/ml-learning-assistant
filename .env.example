# ==============================================================================
# 30-Day Automated Machine Learning Daily Learning Assistant Environment Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI LLM Providers (Specify OpenRouter, Gemini, or Anthropic)
# ------------------------------------------------------------------------------
# OpenRouter API (Access free models: gemini-2.0-flash, llama-3.3-70b, deepseek-r1)
OPENROUTER_API_KEY="sk-or-v1-..."
OPENROUTER_MODEL="google/gemini-2.0-flash-exp:free"

# Google Gemini API
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# Anthropic Claude API (Optional)
ANTHROPIC_API_KEY="sk-ant-..."

# Preferred Provider Order Override: "openrouter", "gemini", or "anthropic" (optional)
LLM_PROVIDER="openrouter"

# ------------------------------------------------------------------------------
# 2. Google Cloud Platform (GCP) Service Account
# ------------------------------------------------------------------------------
# Paste raw JSON string, base64-encoded string, or relative path to service-account.json
# Required GCP Roles / APIs enabled:
#   - Google Drive API
#   - Google Calendar API
#   - Gmail API
GCP_SA_KEY='{"type": "service_account", "project_id": "...", "private_key_id": "...", "private_key": "...", "client_email": "...", "client_id": "..."}'

# Recipient email address for daily lesson notifications
RECIPIENT_EMAIL="your_email@domain.com"

# Optional: Google Workspace delegated user email (for domain-wide delegation in Gmail API)
GMAIL_DELEGATED_USER="your_email@domain.com"

# Optional: Dedicated Google Calendar ID (defaults to 'primary')
GOOGLE_CALENDAR_ID="primary"

# Optional: Specific Google Drive folder ID to keep uploads organized
GOOGLE_DRIVE_FOLDER_ID="1AbCdEfGhIjKlMnOpQrStUvWxYz"

# ------------------------------------------------------------------------------
# 3. Slack Integration (Use Bot Token OR Incoming Webhook)
# ------------------------------------------------------------------------------
# Slack Bot User OAuth Token (starts with xoxb-)
SLACK_BOT_TOKEN="xoxb-your-bot-token"
SLACK_CHANNEL="#ml-learning"

# Or Slack Incoming Webhook URL (targeting #ml-learning channel)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"

# ------------------------------------------------------------------------------
# 4. Optional SMTP Fallback for Email Dispatch
# ------------------------------------------------------------------------------
# Used only if Gmail API delegation is not configured
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@domain.com"
SMTP_PASSWORD="your_app_password"
